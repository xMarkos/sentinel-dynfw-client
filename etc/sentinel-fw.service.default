[Unit]
Description=Turris Sentinel dynamic firewall client
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
EnvironmentFile=/opt/sentinel-fw/etc/variables
WorkingDirectory=/opt/sentinel-fw
RuntimeDirectory=sentinel-fw

ExecStart=/opt/sentinel-fw/env/bin/python src/main.py --cache-dir ${RUNTIME_DIRECTORY} --backend nftables --nft-table ${DYNFW_NFT_TABLE} --ipset4 ${DYNFW_SET_V4} --ipset6 ${DYNFW_SET_V6} --expand-ipv6-prefix ${DYNFW_EXPAND_IPV6_PREFIX} --logger ${DYNFW_LOGGER} $DYNFW_ARGS
KillSignal=SIGINT

ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

Restart=on-failure
RestartSec=5
TimeoutStopSec=5
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
